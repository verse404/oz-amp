rules_version = '2';

// OZ Amp — Strict Owner-Only Cloud Firestore Security Rules
// Paste these rules into: Firebase Console -> Firestore Database -> Rules -> Publish
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can ONLY read and write their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'updatedAtIso',
          'theme',
          'cityFilter',
          'monitoredSingers',
          'reminders',
          'savedWorldFestivals',
          'customConcerts',
          'dedicatedCustomSingers',
          'dedicatedMutedIds'
        ]);
    }

    // Deny all other collections by default (fail-closed)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
