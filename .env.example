# Optional: Free Ticketmaster Discovery API v2 key (https://developer.ticketmaster.com/)
# Enables automatic live syncing of Ticketmaster AU & Live Nation AU concerts in Sydney & Melbourne.
TICKETMASTER_API_KEY=

# Optional: Default outbound HTTPS webhook URL for 1-click push test alerts
# Allowed hosts: api.day.app (Bark), api.telegram.org, discord.com, hooks.slack.com
REMINDER_WEBHOOK_URL=

# Server bind configuration (strictly 127.0.0.1 for local/Cloudtop safety)
BFF_HOST=127.0.0.1
BFF_PORT=3102
CACHE_TTL_HOURS=12
